{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Personal Wellness Blueprint Food Schema",
  "version": "1.1",
  "type": "object",
  "required": [
    "id",
    "version",
    "identity",
    "classification",
    "tags",
    "nutritionHighlights",
    "knowledge",
    "suitability",
    "allergens",
    "contraindications",
    "personalisation",
    "supports",
    "relationships",
    "practical",
    "editorial",
    "evidence",
    "metadata",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^F[0-9]{3}$"
    },
    "version": {
      "type": "string"
    },
    "identity": {
      "type": "object",
      "required": [
        "name",
        "scientificName",
        "slug"
      ]
    },
    "classification": {
      "type": "object",
      "required": [
        "foodGroup",
        "category"
      ]
    },
    "images": {
      "type": "object"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "nutritionHighlights": {
      "type": "object"
    },
    "knowledge": {
      "type": "object"
    },
    "suitability": {
      "type": "object"
    },
    "allergens": {
      "type": "object"
    },
    "contraindications": {
      "type": "object"
    },
    "personalisation": {
      "type": "object"
    },
    "supports": {
      "type": "object"
    },
    "relationships": {
      "type": "object"
    },
    "practical": {
      "type": "object"
    },
    "editorial": {
      "type": "object"
    },
    "evidence": {
      "type": "object"
    },
    "metadata": {
      "type": "object"
    },
    "status": {
      "type": "object"
    }
  },
  "additionalProperties": false
}