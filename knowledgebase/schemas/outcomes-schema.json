{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "outcomes-schema.json",
  "title": "Outcomes",
  "description": "Canonical Personal Wellness Blueprint outcomes linking user-stated wellness goals directly to body systems, biological mechanisms and demographic modifiers. This is both the user-facing goal vocabulary (the questionnaire's PF014 options are these OUT-codes directly) and the structured physiological target layer the scoring engine works from. The separate goals.json layer has been retired.",
  "type": "object",
  "required": ["version", "status", "description", "outcomes"],
  "properties": {
    "version": { "type": "string" },
    "status": { "type": "string", "enum": ["Draft", "Active", "Deprecated"] },
    "description": { "type": "string" },
    "outcomes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "description", "goals", "primaryBodySystems", "secondaryBodySystems", "candidateMechanisms", "status"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^OUT[0-9]{3}$"
          },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "goals": {
            "type": "array",
            "description": "Deprecated - goals.json has been retired and this is always empty now. Kept only so older records still validate against this schema without a shape change.",
            "items": {
              "type": "string",
              "pattern": "^GOAL[0-9]{3}$"
            }
          },
          "primaryBodySystems": {
            "type": "array",
            "description": "Must match ids in body-systems.json.",
            "items": {
              "type": "string",
              "pattern": "^BS[0-9]{3}$"
            }
          },
          "secondaryBodySystems": {
            "type": "array",
            "description": "Must match ids in body-systems.json.",
            "items": {
              "type": "string",
              "pattern": "^BS[0-9]{3}$"
            }
          },
          "candidateMechanisms": {
            "type": "array",
            "description": "Must match ids in mechanisms.json.",
            "items": {
              "type": "string",
              "pattern": "^MEC[0-9]{3}$"
            }
          },
          "demographicModifiers": {
            "type": "object",
            "description": "Optional demographic weighting applied to this outcome.",
            "properties": {
              "ageRanges": {
                "type": "array",
                "items": { "type": "string" }
              },
              "gender": {
                "type": "array",
                "items": { "type": "string" }
              }
            },
            "additionalProperties": false
          },
          "status": { "type": "string", "enum": ["Active", "Proposed", "Deprecated"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
