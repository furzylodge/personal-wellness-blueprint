{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "product-mechanisms-schema.json",
  "title": "Product Mechanism Relationships",
  "description": "Weighted Product -> Mechanism relationships, mirroring food-mechanisms.json for the supplement side. This file is DERIVED, not hand-curated: it must be regenerated from product-bioactives.json x bioactive-mechanisms.json and product-nutrients.json x nutrient-mechanisms.json whenever any of those change. Each relationship's top-level strength/confidence reflect its single strongest contributing bioactive or nutrient path; 'contributors' preserves every path so the recommendation stays auditable back to the active ingredient.",
  "type": "object",
  "required": ["version", "status", "description", "generationRule", "productCount", "productMechanismRelationshipCount", "products"],
  "properties": {
    "version": { "type": "string" },
    "status": { "type": "string", "enum": ["ACTIVE", "PROPOSED_NO_REPOSITORY_CHANGES", "DEPRECATED"] },
    "description": { "type": "string" },
    "generationRule": { "type": "string" },
    "productCount": { "type": "integer", "minimum": 0 },
    "productMechanismRelationshipCount": { "type": "integer", "minimum": 0 },
    "products": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["productId", "productName", "mechanismCount", "mechanisms"],
        "properties": {
          "productId": { "type": "string", "pattern": "^PRD[0-9]{3}$" },
          "productName": { "type": "string", "minLength": 1 },
          "mechanismCount": { "type": "integer", "minimum": 0 },
          "mechanisms": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "name", "primaryBodySystems", "primaryBodySystemNames", "strength", "confidence", "contributors"],
              "properties": {
                "id": { "type": "string", "pattern": "^MEC[0-9]{3}$" },
                "name": { "type": "string", "minLength": 1 },
                "primaryBodySystems": {
                  "type": "array",
                  "items": { "type": "string", "pattern": "^BS[0-9]{3}$" }
                },
                "primaryBodySystemNames": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "strength": { "type": "integer", "minimum": 1, "maximum": 5 },
                "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
                "contributors": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": ["type", "id", "status", "mechanismStrength", "mechanismConfidence", "combinedConfidence"],
                    "properties": {
                      "type": { "type": "string", "enum": ["bioactive", "vitamin", "mineral"] },
                      "id": { "type": "string" },
                      "status": { "type": "string", "enum": ["DIRECT", "SOURCE_DEFINED"] },
                      "mechanismStrength": { "type": "integer", "minimum": 1, "maximum": 5 },
                      "mechanismConfidence": { "type": "string", "enum": ["High", "Moderate", "Emerging", "Low"] },
                      "combinedConfidence": { "type": "number", "minimum": 0, "maximum": 1 }
                    },
                    "additionalProperties": false
                  }
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
